" ~/.vimrc — Python + C on macOS
" Completion/diagnostics: vim-lsp + asyncomplete (clangd for C, pylsp/pyright for Python)

set nocompatible

" ---------- vim-plug (auto-installs itself) ----------
let s:plug = expand('~/.vim/autoload/plug.vim')
if empty(glob(s:plug))
  silent execute '!curl -fLo ' . s:plug . ' --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

call plug#begin('~/.vim/plugged')
" LSP: go-to-definition, diagnostics, rename, hover, format
Plug 'prabirshrestha/vim-lsp'
Plug 'mattn/vim-lsp-settings'           " :LspInstallServer installs clangd / pylsp for you
" Autocomplete popup
Plug 'prabirshrestha/asyncomplete.vim'
Plug 'prabirshrestha/asyncomplete-lsp.vim'
" Better syntax highlighting for many languages
Plug 'sheerun/vim-polyglot'
" Looks
Plug 'morhetz/gruvbox'
Plug 'itchyny/lightline.vim'
" Editing / navigation
Plug 'tpope/vim-commentary'             " gcc = comment line, gc in visual
Plug 'jiangmiao/auto-pairs'             " auto-close () [] {} \"\"
Plug 'preservim/nerdtree'               " file tree
Plug 'junegunn/fzf'                     " fuzzy finder (binary from brew)
Plug 'junegunn/fzf.vim'
call plug#end()

" ---------- General ----------
syntax on
filetype plugin indent on
set encoding=utf-8
set number relativenumber
set cursorline
set mouse=a
set clipboard=unnamed                   " yank/paste with macOS clipboard (needs brew vim)
set hidden
set updatetime=300
set signcolumn=yes
set scrolloff=5
set laststatus=2 noshowmode
set ignorecase smartcase incsearch hlsearch
set expandtab shiftwidth=4 tabstop=4 softtabstop=4 autoindent
set backspace=indent,eol,start
set wildmenu
set splitright splitbelow
set noswapfile
set shortmess+=c

" Persistent undo
if !isdirectory(expand('~/.vim/undo'))
  call mkdir(expand('~/.vim/undo'), 'p')
endif
set undofile undodir=~/.vim/undo//

" ---------- Colors ----------
" Old Terminal.app doesn't do truecolor; iTerm2 / kitty / new Terminal do
if has('termguicolors') && $TERM_PROGRAM !=# 'Apple_Terminal'
  set termguicolors
endif
set background=dark
let g:gruvbox_contrast_dark = 'medium'
silent! colorscheme gruvbox
let g:lightline = { 'colorscheme': 'gruvbox' }

" ---------- Keys ----------
let mapleader = ' '
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader><space> :nohlsearch<CR>
nnoremap <leader>e :NERDTreeToggle<CR>
nnoremap <leader>p :Files<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>/ :Rg<CR>
" window movement
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ---------- Completion ----------
let g:asyncomplete_auto_popup = 1
let g:asyncomplete_auto_completeopt = 0
set completeopt=menuone,noinsert,noselect
inoremap <expr> <Tab>   pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
" <C-Space> forces the popup open
imap <C-Space> <Plug>(asyncomplete_force_refresh)

" ---------- LSP ----------
let g:lsp_diagnostics_echo_cursor = 1     " show error under cursor in cmdline
let g:lsp_diagnostics_virtual_text_enabled = 1
let g:lsp_document_highlight_enabled = 1  " highlight other uses of symbol under cursor
let g:lsp_settings_filetype_python = ['pylsp-all', 'pyright-langserver']

function! s:on_lsp_buffer_enabled() abort
  setlocal omnifunc=lsp#complete
  if exists('+tagfunc') | setlocal tagfunc=lsp#tagfunc | endif
  nmap <buffer> gd <Plug>(lsp-definition)
  nmap <buffer> gD <Plug>(lsp-declaration)
  nmap <buffer> gr <Plug>(lsp-references)
  nmap <buffer> gi <Plug>(lsp-implementation)
  nmap <buffer> K  <Plug>(lsp-hover)
  nmap <buffer> [d <Plug>(lsp-previous-diagnostic)
  nmap <buffer> ]d <Plug>(lsp-next-diagnostic)
  nmap <buffer> <leader>rn <Plug>(lsp-rename)
  nmap <buffer> <leader>ca <Plug>(lsp-code-action)
  nmap <buffer> <leader>d  <Plug>(lsp-document-diagnostics)
  nmap <buffer> <leader>f  <Plug>(lsp-document-format)
endfunction

augroup lsp_install
  autocmd!
  autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
augroup END

" ---------- Python / C ----------
function! s:StripTrailing() abort
  let l:view = winsaveview()
  keeppatterns %s/\s\+$//e
  call winrestview(l:view)
endfunction

augroup lang
  autocmd!
  autocmd FileType python setlocal shiftwidth=4 tabstop=4 colorcolumn=89
  autocmd FileType c,cpp  setlocal shiftwidth=4 tabstop=4 colorcolumn=81 cindent
  autocmd FileType make   setlocal noexpandtab
  autocmd BufWritePre *.py,*.c,*.h,*.cpp,*.hpp call s:StripTrailing()

  " <leader>r = save + run current file
  autocmd FileType python nnoremap <buffer> <leader>r :w<CR>:!python3 %:S<CR>
  autocmd FileType c      nnoremap <buffer> <leader>r :w<CR>:!clang -std=c17 -Wall -Wextra -g %:S -o %:p:r:S && %:p:r:S<CR>
  autocmd FileType cpp    nnoremap <buffer> <leader>r :w<CR>:!clang++ -std=c++20 -Wall -Wextra -g %:S -o %:p:r:S && %:p:r:S<CR>
  " <leader>m = run make in current dir
  autocmd FileType c,cpp  nnoremap <buffer> <leader>m :w<CR>:make<CR>
augroup END
